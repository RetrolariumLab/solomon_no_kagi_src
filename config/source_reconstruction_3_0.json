  "delta": [
    {
      "id": "retrolarium-descriptor",
      "kind": "tooling",
      "summary": "solomons_key.rlj names the game, its kit profile solomons-key.v1, the revisions it builds and its asset split; the studio views come from the kit's profile."
    },
    {
      "id": "editing-moves-to-retrolarium",
      "kind": "tooling",
      "summary": "The editors, their models, the workspace composer, the UI smokes and their tests, Make targets and documentation are removed; editing happens in Retrolarium Studio over hack/<revision>/ (docs/retrolarium.md)."
    },
    {
      "id": "studio-check",
      "kind": "validation",
      "summary": "make studio-check: in a throwaway copy the kit prepares, validates and rebuilds every revision with no edits, byte for byte."
    },
    {
      "id": "tag-bound-2x-audits",
      "kind": "validation",
      "summary": "The 2.x manifests describe their tags' trees, so their audits run at the tag in a disposable clone; the functional 2.x gate stays on HEAD."
    },
    {
      "id": "object-names",
      "kind": "source",
      "summary": "Enemy AI handlers are named after the enemies they run (Panel Monster, slow and fast Spark ball, Nuel and Ghost, Demonhead, Salamander, Dragon, Goblin, Gargoyle, flames, fairy, Mighty Bomb Jack), and the item names follow the owner's object review: Devil's Emblem, zodiac panels by element, the score rewards by look, the Mighty Bomb Jack medal."
    },
    {
      "id": "kit-toolchain",
      "kind": "toolchain",
      "summary": "The repository no longer carries ca65 and ld65: CA65 and LD65 default to the cc65 Retrolarium Kit builds and ships (the same 2.19 0fca835), still checked by size and SHA-256 against config/toolchain.json, and bin/ is gone."
    },
    {
      "id": "shared-linter",
      "kind": "tooling",
      "summary": "make lint-asm and make format run Retrolarium Kit's shared linter (rltool lint) over config/lint.json: the ca65 style for src and the text contract; asm_style.py and its tests move to the kit. build.project lint and the public-text check stay here."
    }
  ],
