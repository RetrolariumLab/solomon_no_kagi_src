  "size_exceptions": {
    "docs/revision_profiles.md": "The contiguous three-region comparison keeps address tables, identity evidence, and profile limitations reviewable together."
  },
  "retained_prefixes": {
    "room": {
      "paths": [
        "docs/room_data_pipeline.md",
        "docs/room_lifecycle.md"
      ],
      "reason": "Room lifecycle owns thread transitions while room data pipeline owns codecs, map updates, and rendering."
    },
    "scheduler": {
      "paths": [
        "docs/scheduler.md",
        "docs/scheduler_entries.md"
      ],
      "reason": "The runtime overview serves implementers while the machine-checked entry table is maintained as evidence."
    },
    "source": {
      "paths": [
        "docs/source_layout.md",
        "docs/source_organization.md",
        "docs/source_reconstruction_1_0.md",
        "docs/source_reconstruction_2_0.md",
        "docs/source_reconstruction_2_1.md"
      ],
      "reason": "Layout, repository policy, and immutable release boundaries have different audiences and maintenance lifecycles."
    }
  },
  "consolidations": [
    {
      "destination": "docs/enemy_system.md",
